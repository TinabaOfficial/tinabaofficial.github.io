<!doctype html>
<html lang="it">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} — {{ site.name }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <meta name="theme-color" content="#f4f3ee">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <link rel="preload" href="/assets/fonts/manrope-latin-400-normal.woff2" as="font" type="font/woff2">
    <link rel="preload" href="/assets/fonts/manrope-latin-700-normal.woff2" as="font" type="font/woff2">
    <link rel="preload" href="/assets/fonts/dm-mono-latin-400-normal.woff2" as="font" type="font/woff2">
    <link rel="icon" href="/assets/favicon.png" type="image/png">
    <link rel="stylesheet" href="/assets/site.css">
    <script type="module" src="/assets/site.js"></script>
</head>
<body>
    <a class="skip-link" href="#main-content">Vai al contenuto</a>
    <header class="site-header">
        <div class="container header-inner">
            <a class="wordmark" href="/" aria-label="Tinaba, home">
                <img class="wordmark-icon" src="/assets/tinaba-logo.png" alt="">
                <span>tinaba</span>
            </a>
            <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation">Menu</button>
            <nav id="main-navigation" class="main-navigation" aria-label="Navigazione principale">
                {% for item in site.navigation %}
                    <a href="{{ item.url }}">{{ item.label }}</a>
                {% endfor %}
                <a class="button button-small" href="/contatti/">Parliamone <span aria-hidden="true">↗</span></a>
            </nav>
        </div>
    </header>
    <main id="main-content">{{ content | safe }}</main>
    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <a class="wordmark wordmark-footer" href="/" aria-label="Tinaba, home"><img class="wordmark-icon" src="/assets/tinaba-logo.png" alt=""><span>tinaba</span></a>
                <p class="footer-note">Digital banking, made possible.</p>
            </div>
            <div class="footer-links">
                <a href="/piattaforma/">La piattaforma</a>
                <a href="/per-le-banche/">Per le banche</a>
                <a href="/tinaba/">Chi siamo</a>
                <a href="/contatti/">Contatti</a>
                <a href="/privacy/">Privacy</a>
            </div>
            <div class="footer-meta">
                <span>{{ site.company.name }}</span>
                <span>{{ site.company.address }}</span>
                <span>{{ site.company.taxId }}</span>
                <span>{{ site.company.rea }}</span>
                <span>{{ site.company.capital }}</span>
                <span>© {{ site.year }} Tinaba</span>
            </div>
        </div>
    </footer>
</body>
</html>

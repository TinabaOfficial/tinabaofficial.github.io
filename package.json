{
    "name": "tinaba-institutional-site",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "dev": "eleventy --serve",
        "build": "eleventy && pagefind --site docs",
        "lint": "eslint .",
        "lint-ts": "npx --yes --package typescript tsc -p jsconfig.json --noEmit",
        "test": "node --test",
        "validate": "npm run lint && npm run lint-ts && npm run test"
    },
    "devDependencies": {
        "@11ty/eleventy": "^3.1.7",
        "@eslint/js": "^10.0.1",
        "@fontsource/manrope": "^5.3.0",
        "eslint": "^10.13.0",
        "eslint-config-eslint": "^14.0.0",
        "globals": "^17.13.0",
        "pagefind": "^1.5.2"
    }
}
